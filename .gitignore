# Large physical-design databases / layouts produced by ORFS runs
runs/**/*.odb
runs/**/*.def
runs/**/*.gds
runs/**/*.gds.gz
runs/**/*.oas
runs/**/*.spef
runs/**/*.v
runs/**/*.sdc.bak
runs/**/*.dat
runs/**/*.rpt.gz
runs/**/objects/
runs/**/results/
# PDK / library collateral must never be committed (see fetch_inputs.md)
*.lef
*.lib
*.lib.gz
*.gds
# Python / misc
__pycache__/
*.pyc
.venv/
runs/**/*.webp
runs/**/*.rtlil
runs/**/*.tmp.log
runs/**/route.guide
.scratch/
# E18: large designs (same rules as runs/)
runs_big/**/*.odb
runs_big/**/*.def
runs_big/**/*.gds
runs_big/**/*.gds.gz
